{
  "name": "class-qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "preview": "node scripts/preview.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "db:local": "node scripts/setup-local-db.js",
    "test:postgres": "node --env-file-if-exists=.env scripts/test-postgres.js",
    "check:privacy": "node scripts/check-privacy.js",
    "test": "node --test test/app.test.js"
  },
  "engines": { "node": ">=22.9" },
  "dependencies": { "express": "5.2.1", "ejs": "7.0.1", "pg": "8.23.1" },
  "devDependencies": { "pg-mem": "3.0.14" }
}
