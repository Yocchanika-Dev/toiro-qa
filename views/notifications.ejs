<%- include('partials/header') %>
<a class="back" href="/questions">← 質問一覧</a><section class="page-heading"><p class="eyebrow">YOUR UPDATES</p><h1>通知 <span class="count">未読 <%= unreadCount %>件</span></h1><p>あなたの質問に届いた回答を確認できます。</p></section>
<div class="notification-toolbar"><nav aria-label="通知の絞り込み"><a href="/notifications" <%- filter === 'all' ? 'aria-current="page"' : '' %>>すべて</a><a href="/notifications?filter=unread" <%- filter === 'unread' ? 'aria-current="page"' : '' %>>未読のみ</a></nav><% if (unreadCount) { %><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">すべて既読にする</button></form><% } %></div>
<% notifications.forEach(notice => { %><article class="panel notification-card <%= notice.is_read ? 'is-read' : 'is-unread' %>" data-notification-id="<%= notice.id %>" data-read="<%= notice.is_read ? 'true' : 'false' %>"><div class="meta"><span class="notice-state"><%= notice.is_read ? '既読' : '未読' %></span><time><%= date(notice.created_at) %></time></div><h2><%= notice.title %></h2><p><strong><%= notice.author_name %></strong>さんから回答が届きました。</p><p class="notice-excerpt"><%= notice.content.slice(0,160) %></p><div class="actions"><form method="post" action="/notifications/<%= notice.id %>/open"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button" type="submit">回答を見る</button></form><form method="post" action="/notifications/<%= notice.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="state" value="<%= notice.is_read ? 'unread' : 'read' %>"><button class="text-button" type="submit"><%= notice.is_read ? '未読に戻す' : '既読にする' %></button></form></div></article><% }) %>
<% if (!notifications.length) { %><section class="empty"><h2><%= filter === 'unread' ? '未読の通知はありません' : 'まだ通知はありません' %></h2><p>静かですね。今のうちにお茶でも。回答が届くと、ここに表示されます。</p></section><% } %>
<%- include('partials/footer') %>
