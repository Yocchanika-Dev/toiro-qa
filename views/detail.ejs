<%- include('partials/header') %>
<a class="back" href="/questions">← 質問一覧</a>
<article class="panel question-detail"><span class="tag"><%= question.category %></span> <span class="status-tag <%= question.status === 'resolved' ? 'is-resolved' : 'is-unresolved' %>"><%= question.status === 'resolved' ? '解決済み' : '未解決' %></span><h1><%= question.title %></h1><div class="meta"><span><%= question.author_name %></span><time><%= date(question.created_at) %></time></div><div class="content"><%= question.content %></div><% if (currentUser && question.user_id === currentUser.id) { %><div class="actions"><form method="post" action="/questions/<%= question.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= question.status === 'resolved' ? 'unresolved' : 'resolved' %>"><button class="button" type="submit"><%= question.status === 'resolved' ? '未解決に戻す' : '解決済みにする' %></button></form><a href="/questions/<%= question.id %>/edit">編集する</a><a class="danger-link" href="/questions/<%= question.id %>/delete">削除する</a></div><% } %></article>
<section id="answers"><div class="section-heading"><h2>みんなの回答 <span class="count"><%= answers.length %>件</span></h2></div>
<% answers.forEach(item => { %><article class="panel answer <%= item.is_best ? 'best-answer' : '' %>" data-answer-id="<%= item.id %>"><% if (item.is_best) { %><p class="best-label">✓ ベストアンサー <span>質問者が選んだ回答</span></p><% } %><div class="meta"><strong><%= item.author_name %></strong><time><%= date(item.created_at) %></time></div><div class="content"><%= item.content %></div><div class="actions"><% if (currentUser && question.user_id === currentUser.id) { %><form method="post" action="/questions/<%= question.id %>/best-answer"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="answer_id" value="<%= item.is_best ? '' : item.id %>"><button class="text-button" type="submit"><%= item.is_best ? 'ベストアンサーを解除' : 'ベストアンサーに選ぶ' %></button></form><% } %><% if (currentUser && item.user_id === currentUser.id) { %><form method="post" action="/questions/<%= question.id %>/answers/<%= item.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button danger-link" type="submit">この回答を削除</button></form><% } %></div></article><% }) %>
<% if (!answers.length) { %><p class="empty-small">まだ回答はありません。あなたの知識を共有してみましょう。</p><% } %></section>
<section class="panel"><h2>回答を書く</h2><% if (currentUser) { %><p class="subtle"><%= currentUser.display_name %>として公開されます。個人情報は書かないでください。</p><%- include('partials/errors') %><form class="stack" method="post" action="/questions/<%= question.id %>/answers"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>回答の内容 <span class="required">必須</span><textarea name="content" required maxlength="10000" rows="6"><%= answer.content || '' %></textarea></label><button class="button" type="submit">回答を投稿</button></form><% } else { %><p>回答するには<a href="/login">ログイン</a>してください。</p><% } %></section>
<%- include('partials/footer') %>
