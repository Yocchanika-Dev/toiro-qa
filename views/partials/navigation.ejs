<nav class="board-navigation" aria-label="webbitメニュー">
<a href="/questions" class="nav-link <%= currentPath === '/questions' && !navCategory && !navStatus && navSort !== 'answers' ? 'is-active' : '' %>"><span class="nav-symbol" aria-hidden="true">⌂</span>ホーム</a>
<a href="/questions?sort=answers" class="nav-link <%= currentPath === '/questions' && navSort === 'answers' && !navCategory && !navStatus ? 'is-active' : '' %>"><span class="nav-symbol" aria-hidden="true">↗</span>回答の多い投稿</a>
<a href="/questions?status=unresolved" class="nav-link <%= currentPath === '/questions' && navStatus === 'unresolved' && !navCategory ? 'is-active' : '' %>"><span class="nav-symbol" aria-hidden="true">?</span>未解決の質問</a>
<% if (currentUser) { %><a href="/notifications" class="nav-link <%= currentPath === '/notifications' ? 'is-active' : '' %>"><span class="nav-symbol" aria-hidden="true">♧</span>通知<% if (unreadCount) { %><span class="notification-badge"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %></a><% } %>
<p class="nav-heading">トピック</p>
<% categories.forEach((topic, index) => { %><a href="/questions?category=<%= encodeURIComponent(topic) %>" class="nav-link <%= currentPath === '/questions' && navCategory === topic ? 'is-active' : '' %>"><span class="topic-dot topic-color-<%= index %>" aria-hidden="true">w/</span><span>w/<%= topic %></span></a><% }) %>
<p class="nav-heading">WEBBITについて</p><a class="nav-link <%= currentPath === '/guide' ? 'is-active' : '' %>" href="/guide"><span class="nav-symbol" aria-hidden="true">i</span>この場所の使い方</a>
<% if (currentUser) { %><a class="nav-link" href="/account"><span class="nav-symbol" aria-hidden="true">○</span>アカウント</a><% } else { %><a class="nav-link" href="/register"><span class="nav-symbol" aria-hidden="true">＋</span>webbitに参加する</a><% } %>
</nav>
