<!doctype html>
<html lang="ja">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="小さな疑問を、みんなの知識に。webbitは授業のつまずきや放課後の発見を共有する学生のQ&Aコミュニティです。"><title><%= title %> | webbit</title><link rel="icon" type="image/svg+xml" href="/webbit-mark.svg"><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/auth.css"><link rel="stylesheet" href="/questions.css"><link rel="stylesheet" href="/best-answer.css"><link rel="stylesheet" href="/likes.css"><link rel="stylesheet" href="/notifications.css"><link rel="stylesheet" href="/webbit.css"><link rel="stylesheet" href="/design-system.css"><script src="/theme.js"></script></head>
<body>
<a class="skip-link" href="#main-content">本文へスキップ</a>
<header class="site-header"><div class="header-brand"><details class="mobile-navigation"><summary aria-label="メニューを開く">☰</summary><div class="mobile-menu"><%- include('navigation') %></div></details><a class="brand" href="/questions" aria-label="webbit ホーム"><img src="/webbit-mark.svg" width="32" height="32" alt=""><span>webbit<span class="brand-dot">.</span></span></a></div><form class="global-search" method="get" action="/questions" role="search"><label class="visually-hidden" for="global-query">webbitを検索</label><span aria-hidden="true">⌕</span><input id="global-query" type="search" name="q" maxlength="150" value="<%= typeof keyword !== 'undefined' ? keyword : '' %>" placeholder="webbit内を検索"><button type="submit" class="visually-hidden">検索</button></form><nav class="header-actions" aria-label="アカウント"><label class="theme-control"><span class="visually-hidden">表示テーマ</span><select id="theme-select" aria-label="表示テーマ"><option value="system">自動</option><option value="light">ライト</option><option value="dark">ダーク</option></select></label><% if (currentUser) { %><a class="notifications-link" href="/notifications" aria-label="通知（未読<%= unreadCount %>件）">通知<% if (unreadCount) { %> <span class="notification-badge"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %></a><a class="nickname" href="/account"><%= currentUser.display_name %></a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">ログアウト</button></form><a class="button" href="/questions/new">＋ 質問する</a><% } else { %><a href="/login">ログイン</a><a class="button" href="/register">参加する</a><% } %></nav></header>
<div class="app-shell"><aside class="sidebar"><%- include('navigation') %><p class="sidebar-footnote">a little question.<br>a bit of knowledge.</p></aside><main id="main-content">
