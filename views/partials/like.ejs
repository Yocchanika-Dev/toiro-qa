<div class="like-control" data-like-answer-id="<%= item.id %>" data-like-count="<%= item.like_count %>" data-liked="<%= item.liked_by_me ? 'true' : 'false' %>"><% if (currentUser) { %><form method="post" action="/questions/<%= question.id %>/answers/<%= item.id %>/like"><input type="hidden" name="page" value="<%= pager.page %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= item.liked_by_me ? 'remove' : 'add' %>"><button class="like-button" type="submit" aria-pressed="<%= item.liked_by_me ? 'true' : 'false' %>"><%= item.liked_by_me ? '♥ いいね済み' : '♡ いいね' %> <span class="like-count"><%= item.like_count %></span></button></form><% } else { %><a class="like-button" href="/login">♡ いいね <span class="like-count"><%= item.like_count %></span></a><% } %></div>
