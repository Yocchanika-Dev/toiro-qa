<%- include('partials/header') %>
<% const hasFilter = !!(keyword || category || status); const feedUrl = (changes) => { const values = { q: keyword, category, status, sort, ...changes }; const params = new URLSearchParams(); for (const [key,value] of Object.entries(values)) if (value) params.set(key,value); return '/questions?' + params.toString(); }; %>
<div class="feed-layout">
<section class="feed-column" aria-label="質問フィード">
<section class="community-intro" id="community-guide"><div><p class="community-name">w/webbit <span>学生のためのQ&Aコミュニティ</span></p><h1>小さな疑問を、<br class="mobile-break">みんなの知識に。</h1><p>授業のつまずきも、放課後の発見も。<br>ひとつの問いから、話してみよう。</p></div><img src="/webbit-mark.svg" width="76" height="76" alt="" class="intro-mark"></section>
<div class="feed-heading"><h2><%= hasFilter ? (category ? 'w/' + category : '検索結果') : 'ホーム' %></h2><span class="count"><%= questions.length %>件の質問</span></div>
<nav class="feed-tabs" aria-label="投稿の並べ替え"><a class="<%= sort === 'newest' ? 'is-selected' : '' %>" href="<%= feedUrl({sort:'newest'}) %>"><span aria-hidden="true">✧</span> 新しい投稿</a><a class="<%= sort === 'answers' ? 'is-selected' : '' %>" href="<%= feedUrl({sort:'answers'}) %>"><span aria-hidden="true">↗</span> 回答が多い順</a></nav>
<details class="feed-filters" <%= hasFilter || sort === 'answers' ? 'open' : '' %>><summary>検索・絞り込み<span><%= status === 'resolved' ? '解決済み' : status === 'unresolved' ? '未解決' : 'すべての状態' %> ▾</span></summary><form class="search-panel" method="get" action="/questions"><input type="hidden" name="q" value="<%= keyword %>"><label>カテゴリ<select name="category"><option value="">すべてのカテゴリ</option><% categories.forEach(item => { %><option <%= category === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label><label>解決状態<select name="status"><option value="">すべての状態</option><option value="unresolved" <%= status === 'unresolved' ? 'selected' : '' %>>未解決</option><option value="resolved" <%= status === 'resolved' ? 'selected' : '' %>>解決済み</option></select></label><label>並べ替え<select name="sort"><option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>新しい順</option><option value="answers" <%= sort === 'answers' ? 'selected' : '' %>>回答が多い順</option></select></label><button class="button" type="submit">検索する</button><a class="subtle" href="/questions">リセット</a></form></details>
<% if (keyword) { %><p class="search-description">「<%= keyword %>」の検索結果</p><% } %>
<div class="question-list"><% questions.forEach(question => { %><article class="question-card" data-question-id="<%= question.id %>"><div class="post-meta"><a class="post-topic" href="/questions?category=<%= encodeURIComponent(question.category) %>"><span class="topic-dot topic-color-<%= categories.indexOf(question.category) %>" aria-hidden="true">w/</span>w/<%= question.category %></a><span aria-hidden="true">·</span><time><%= date(question.created_at) %></time></div><h3><a href="/questions/<%= question.id %>"><%= question.title %></a></h3><p class="excerpt"><%= question.content.slice(0, 180) %></p><div class="post-author"><%- include('partials/avatar', { name: question.author_name }) %><span>u/<%= question.author_name %></span></div><div class="post-actions"><a class="reply-chip" href="/questions/<%= question.id %>#answers"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 11a8 8 0 0 1-8 8H5l-3 3v-7A9 9 0 1 1 20 11Z"/></svg><strong><%= question.answer_count %></strong>件の回答</a><span class="status-tag <%= question.status === 'resolved' ? 'is-resolved' : 'is-unresolved' %>"><%= question.status === 'resolved' ? '✓ 解決済み' : '未解決' %></span><a class="thread-link" href="/questions/<%= question.id %>">投稿を読む <span aria-hidden="true">↗</span></a></div></article><% }) %>
<% if (!questions.length) { %><section class="empty"><img src="/webbit-mark.svg" width="44" height="44" alt=""><h3><%= hasFilter ? '条件に合う質問が見つかりませんでした' : 'まだ質問がありません' %></h3><p><%= hasFilter ? 'キーワード・カテゴリ・解決状態を変えて探してみてください。' : '全員わかってる？ まさか。最初の疑問を放流してみよう。' %></p><a class="button" href="/questions/new">質問を投稿する →</a></section><% } %></div>
</section>
<aside class="community-rail" aria-label="コミュニティ案内"><section class="community-card"><div class="community-cover"><span>w/</span><img src="/webbit-mark.svg" width="44" height="44" alt=""></div><div class="community-card-body"><h2>webbitへようこそ。</h2><p>Web + bit。小さな知識のかけらが集まる、学生のための掲示板です。</p><p>「ここだけわからない」から、一緒に考えてみませんか。</p><a class="button" href="/questions/new">＋ 質問を投稿する</a><div class="community-facts"><span><strong>3</strong>トピック</span><span><strong>∞</strong>問いの可能性</span></div></div></section><section class="rail-section"><p class="rail-kicker">TOPICS</p><h2>話したい場所を見つけよう</h2><% categories.forEach((topic,index) => { %><a class="rail-topic" href="/questions?category=<%= encodeURIComponent(topic) %>"><span class="topic-dot topic-color-<%= index %>" aria-hidden="true">w/</span><span><strong>w/<%= topic %></strong><small><%= index === 0 ? '授業の「なぜ？」を持ち寄る' : index === 1 ? '制作や活動のヒントを共有' : 'ちょっと気になることも' %></small></span><span aria-hidden="true">›</span></a><% }) %></section><section class="rail-section community-rules"><p class="rail-kicker">A GOOD PLACE TO ASK</p><h2>気持ちよく話すために</h2><ol><li>小さな疑問も、遠慮なく。</li><li>試したことも一緒に書こう。</li><li>回答には、やさしさを。</li><li>名前はニックネームで。</li></ol></section><p class="rail-signoff">a little question. a bit of knowledge.<br>webbit © 2026</p></aside>
</div>
<%- include('partials/footer') %>
