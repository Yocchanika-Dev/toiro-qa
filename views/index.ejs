<%- include('partials/header') %>
<section class="hero"><p class="eyebrow">LEARN TOGETHER</p><h1>その「わからない」を、<br>みんなの学びに。</h1><p>授業の疑問も、放課後の発見も。気軽に質問してみよう。</p></section>
<form class="search-panel" method="get" action="/questions"><label class="search-field">キーワード<input type="search" name="q" maxlength="150" value="<%= keyword %>" placeholder="気になる質問を探す"></label><label>カテゴリ<select name="category"><option value="">すべてのカテゴリ</option><% categories.forEach(item => { %><option <%= category === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label><button class="button" type="submit">検索する</button><a class="subtle" href="/questions">リセット</a></form>
<div class="section-heading"><h2><%= keyword || category ? '検索結果' : 'みんなの質問' %> <span class="count"><%= questions.length %>件</span></h2><span class="subtle">新しい順</span></div>
<div class="question-list"><% questions.forEach(question => { %><article class="question-card"><div class="answer-count"><strong><%= question.answer_count %></strong><span>回答</span></div><div class="question-summary"><span class="tag"><%= question.category %></span><h3><a href="/questions/<%= question.id %>"><%= question.title %></a></h3><p class="excerpt"><%= question.content.slice(0, 120) %></p><div class="meta"><span><%= question.author_name %></span><time><%= date(question.created_at) %></time></div></div><span class="arrow" aria-hidden="true">↗</span></article><% }) %>
<% if (!questions.length) { %><section class="empty"><span class="empty-icon">?</span><h3><%= keyword || category ? '条件に合う質問が見つかりませんでした' : 'まだ質問がありません' %></h3><p><%= keyword || category ? 'キーワードやカテゴリを変えて探してみてください。' : '最初の疑問を、ここで共有してみませんか。' %></p><a href="/questions/new">質問を投稿する →</a></section><% } %></div>
<%- include('partials/footer') %>
