{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "git": { "deploymentEnabled": { "study-notes": false } },
  "functions": {
    "api/index.js": { "includeFiles": "{views,public}/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
